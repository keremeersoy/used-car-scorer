{
  "manifest_version": 3,
  "name": "Araç Skoru",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["https://*.sahibinden.com/*"],
  "action": { "default_title": "İlanı oku" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
